# Copy to `.env.local` and adjust if needed. All values are optional — the
# defaults below are what the app uses when the file is absent.

# Kickbase REST base URL.
VITE_API_BASE_URL=https://api.kickbase.com

# Kickbase image CDN. Player/club/user image paths are resolved against this.
VITE_CDN_BASE_URL=https://kickbase.b-cdn.net

# The API currently reflects CORS headers for any origin, so the browser can
# call it directly. If that ever changes, set both of these and Vite will proxy
# API traffic through the dev server instead.
# VITE_USE_DEV_PROXY=true
# VITE_API_BASE_URL=/kb-api
