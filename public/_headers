# Response headers for the Cloudflare static-asset layer — the same policy
# nginx.conf applies in the Docker image. Vite copies this file into dist/,
# where Workers assets picks it up; nginx serves it as an inert text file.

# Vite writes a content hash into every filename under /assets/.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
